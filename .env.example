# Copy to .env (never commit .env). All values are optional.

# Gemini answers in "Ask the archive" (website /api/ask and the Streamlit dashboard).
# Without it, both still answer with cited NASA passages (retrieval only, no generated text).
GOOGLE_API_KEY=

# API server: comma-separated origins allowed to call the API from a browser (default: *).
# Set it to your website's address when the site and API are deployed separately.
ALLOWED_ORIGINS=*

# Port for the API + website server (Hugging Face Spaces uses 7860; Render sets it for you).
PORT=7860
